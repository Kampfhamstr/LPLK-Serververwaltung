<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><AssemblyName>LPLK_Parachute</AssemblyName><Version>0.1.6</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="1.4.14" ExcludeAssets="runtime" PrivateAssets="all" />
    <Compile Include="../../_Gemeinsam/ModuleSupport.cs" Link="Shared/ModuleSupport.cs" />
  </ItemGroup>
  <Target Name="CreateZip" AfterTargets="Publish">
    <ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true" />
  </Target>
  <ItemGroup>
    <None Include="../../_Gemeinsam/GPL-3.0.txt" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../_Gemeinsam/GPL-3.0.txt" Link="source/_Gemeinsam/GPL-3.0.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Update="NOTICE.txt" CopyToPublishDirectory="PreserveNewest" />
    <None Include="*.cs" Link="source/LPLK_Parachute/Rohskripte/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../_Gemeinsam/ModuleSupport.cs" Link="source/_Gemeinsam/ModuleSupport.cs" CopyToPublishDirectory="PreserveNewest" />
    <None Include="LPLK_Parachute.csproj" Link="source/LPLK_Parachute/Rohskripte/LPLK_Parachute.csproj" CopyToPublishDirectory="PreserveNewest" />
    <None Update="packages.lock.json" Link="source/LPLK_Parachute/Rohskripte/packages.lock.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../_Gemeinsam/CompactMenu.cs" Link="Shared/CompactMenu.cs" /><Compile Include="../../_Gemeinsam/WatchedSettings.cs" Link="Shared/WatchedSettings.cs" /></ItemGroup>
  <ItemGroup><None Include="../../_Gemeinsam/CompactMenu.cs" Link="source/_Gemeinsam/CompactMenu.cs" CopyToPublishDirectory="PreserveNewest" /><None Include="../../_Gemeinsam/WatchedSettings.cs" Link="source/_Gemeinsam/WatchedSettings.cs" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
