  <ItemGroup><PackageReference Include="SwiftlyS2.CS2" Version="1.4.14" ExcludeAssets="runtime" PrivateAssets="all"/><Compile Include="../../_Gemeinsam/ModuleSupport.cs" Link="Shared/ModuleSupport.cs"/></ItemGroup>
