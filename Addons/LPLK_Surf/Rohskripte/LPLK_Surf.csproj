<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks><AssemblyName>LPLK_Surf</AssemblyName><Version>0.1.0</Version><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
 <ItemGroup><PackageReference Include="SwiftlyS2.CS2" Version="1.4.14" ExcludeAssets="runtime" PrivateAssets="all"/><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11"/><PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/><Compile Include="../../_Gemeinsam/ModuleSupport.cs" Link="Shared/ModuleSupport.cs"/><Compile Include="../../_Gemeinsam/CompactMenu.cs" Link="Shared/CompactMenu.cs"/><Compile Include="../../_Gemeinsam/ModeScope.cs" Link="Shared/ModeScope.cs"/></ItemGroup>
 <!-- Delivery targets the Debian x64 game server; tests retain their Windows assets. -->
 <Target Name="FilterNativePublishAssets" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory">
  <ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[/\\](?!linux-x64[/\\])'))"/></ItemGroup>
  <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../LPLK_Economy/Rohskripte/native/libe_sqlite3.so')" Text="Run scripts/Build-EconomyNative.ps1 before publishing."/>
  <ItemGroup>
   <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[/\\]linux-x64[/\\]native[/\\]libe_sqlite3\.so$'))"/>
   <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/../../LPLK_Economy/Rohskripte/native/libe_sqlite3.so"><RelativePath>runtimes/linux-x64/native/libe_sqlite3.so</RelativePath><CopyToPublishDirectory>Always</CopyToPublishDirectory></ResolvedFileToPublish>
  </ItemGroup>
 </Target>
 <Target Name="CreateZip" AfterTargets="Publish"><ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true"/></Target>
</Project>






