<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>LPLK_Zombie</AssemblyName><Version>0.1.0</Version><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile></PropertyGroup>
 <ItemGroup>
  <Compile Remove="CompatAPI/**"/>
  <ProjectReference Include="CompatAPI/IHanZriotAPI.csproj"/>
  <PackageReference Include="SwiftlyS2.CS2" Version="1.4.14" ExcludeAssets="runtime" PrivateAssets="all"/>
  <Compile Include="../../_Gemeinsam/ModuleSupport.cs" Link="Shared/ModuleSupport.cs"/>
  <Compile Include="../../_Gemeinsam/CompactMenu.cs" Link="Shared/CompactMenu.cs"/>
  <Compile Include="../../_Gemeinsam/AdminActionPolicy.cs" Link="Shared/AdminActionPolicy.cs"/>
  <Compile Include="../../_Gemeinsam/ModeScope.cs" Link="Shared/ModeScope.cs"/>
  <Content Include="resources/**/*" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest"/>
  <Content Include="../PROVENANCE.json" Link="PROVENANCE.json" CopyToOutputDirectory="PreserveNewest"/>
 </ItemGroup>
 <Target Name="CreateZip" AfterTargets="Publish"><ZipDirectory SourceDirectory="$(PublishDir)../" DestinationFile="$(OutputPath)../$(AssemblyName).zip" Overwrite="true"/></Target>
</Project>
